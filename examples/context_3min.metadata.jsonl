e_localization\": [\n    {\n      \"time_sec\": number,\n      \"goalkeeper\": [xmin, ymin, xmax, ymax] or null\n    }\n  ]\n}\n```", "event_type": "goal_kick", "active_roles": ["goalkeeper"], "metadata": {"record_schema_version": 1, "sample_id": "england_epl/2014-2015/2015-02-21 - 18-00 Crystal Palace 1 - 2 Arsenal/Clearance_H2_1224026", "game": "england_epl/2014-2015/2015-02-21 - 18-00 Crystal Palace 1 - 2 Arsenal", "half": 2, "event_type": "goal_kick", "event_name": "Goal Kick", "setting": "context_3min", "video_path": "soccerstvg/videos/context_3min/england_epl/2014-2015/2015-02-21 - 18-00 Crystal Palace 1 - 2 Arsenal/Clearance_H2_1224026.mp4", "source_half_video": "external_data/SoccerNet/england_epl/2014-2015/2015-02-21 - 18-00 Crystal Palace 1 - 2 Arsenal/2_720p.mp4", "spatial_annotation_path": "soccerrole/spatial/annotations/england_epl/2014-2015/2015-02-21 - 18-00 Crystal Palace 1 - 2 Arsenal/Clearance_H2_1224026_annotation.json", "spatial_annotation_sha256": "aebab053df1451ea7a7b9984d870ac8f7c0f136bcd4d2cc18a5a703924d9cdf2", "stage2_event_type": "goal_kick", "stage2_declared_roles": ["goalkeeper"], "active_roles": ["goalkeeper"], "predicate_role_structure": "goalkeeper — goal_kick", "keyframe_fps": 2.0, "bbox_format": "xyxy_normalized_0_1000", "window_start": 1114.839835, "window_end": 1294.839835, "window_duration": 180.0, "target_start_in_window": 106.448165, "target_end_in_window": 109.851165, "sn_anchor_time_abs": 1224.026, "target_event_annotation_identifiers": {"matched_source_occurrence_id": "d015b20692869e555f7a", "source_occurrence_id": "d015b20692869e555f7a", "matched_source_sequence_type": "Clearance", "soccernet_annotation": "Clearance_H2_1224026"}, "context_policy_version": 8, "occurrence_counting_policy": "qualified_soccernet_target_or_timestamp_or_contained_trim_v1", "generation_fingerprint": "b309572569e4f61901b9cebd3208f62675a9b53a14406cf6bd0954d2bf8ef61a", "source_manifest": "frozen_manifests/context_3min/retained.jsonl", "prompt_spec_ver